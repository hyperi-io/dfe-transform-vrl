# =============================================================================
# Test Mode Selection
# =============================================================================
# TEST_MODE controls which backends integration and e2e tests use:
#
#   "remote"  (default) — use the Kafka endpoints from env vars below
#   "docker"            — use dfe-docker infra profile (localhost, no auth, no TLS)
#
# When TEST_MODE=docker, remote Kafka env vars are ignored for tests.
# When TEST_MODE=remote (or unset), tests use env vars and skip if unreachable.
TEST_MODE="remote"

# =============================================================================
# Kafka for the TEST HARNESS (remote — fill in your cluster details)
# =============================================================================
# Read by tests/common/mod.rs only. The app itself reads nothing here — its
# credential names carry the DFE_TRANSFORM_ prefix, in the block below.
KAFKA_BROKERS="kafka.example.com:9092"
KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_USER="<service-user>"
KAFKA_SASL_PASSWORD="<password>"

# =============================================================================
# DFE Transform VRL Application Config (DFE_TRANSFORM_* prefix)
# =============================================================================
# DFE_TRANSFORM_PIPELINE_NAME="dev-pipeline"
# DFE_TRANSFORM_SOURCE_BROKERS="kafka.example.com:9092"
# DFE_TRANSFORM_SOURCE_TOPICS="events_land"
# DFE_TRANSFORM_SOURCE_GROUP_ID="dfe-transform-vrl-dev"
# DFE_TRANSFORM_SINK_TOPIC="events_load"
# DFE_TRANSFORM_SINK_BROKERS="kafka.example.com:9092"
# One cluster with one SCRAM principal feeds both endpoints; the per-endpoint
# names (DFE_TRANSFORM_SOURCE_SASL_*, DFE_TRANSFORM_SINK_SASL_*) override it.
# DFE_TRANSFORM_KAFKA_SASL_USERNAME="<service-user>"
# DFE_TRANSFORM_KAFKA_SASL_PASSWORD="<password>"

# =============================================================================
# Memory Guard
# =============================================================================
# DFE_TRANSFORM_VRL_MEMORY_LIMIT_BYTES="0"
# DFE_TRANSFORM_VRL_MEMORY_PRESSURE_THRESHOLD="0.80"
# DFE_TRANSFORM_VRL_MEMORY_CGROUP_HEADROOM="0.85"

# =============================================================================
# Test Config
# =============================================================================
TEST_TOPIC_PREFIX="dfe-transform-vrl-test"

# =============================================================================
# Container Registry (CI/CD)
# =============================================================================
ARTIFACTORY_USERNAME="<email>"
ARTIFACTORY_PASSWORD="<token>"
